  "license": "MIT",
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11",
    "vite-plugin-dts": "4.3.0"
  },
  "dependencies": {
    "selectable-grid": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": ">=16.8.0",
    "react": ">=16.8.0"
  }
}
